{
  "description": "Procurement: agent completes a checkout totalling $1,390.00 (139000 minor units) against a PO ceiling of $1,200.00 (max_total 120000, USD). Total exceeds the cap, so the policy denies with a human-readable reason and the charge never reaches the merchant.",
  "input": {
    "action": "tool_pre_invoke",
    "kind": "tool_pre_invoke",
    "mode": "input",
    "subject": {
      "claims": {
        "sub": "agent|procurement-bot",
        "email": "procurement-agent@acme.example.com"
      }
    },
    "resource": {
      "type": "tool",
      "name": "shopify-complete_checkout",
      "uri": null
    },
    "context": {
      "mandate": {
        "max_total": 120000,
        "currency": "USD"
      }
    },
    "payload": {
      "name": "shopify-complete_checkout",
      "args": {
        "checkout": {
          "status": "ready_for_complete",
          "currency": "USD",
          "continue_url": "https://shop.example.com/checkouts/abc123/continue",
          "totals": [
            { "type": "subtotal", "amount": 129000, "display_text": "Subtotal" },
            { "type": "tax", "amount": 10000, "display_text": "Tax" },
            { "type": "total", "amount": 139000, "display_text": "Total" }
          ],
          "line_items": [
            {
              "id": "li_1",
              "item": {
                "id": "prod_999",
                "title": "Standing desk (bulk order)",
                "price": 129000
              },
              "quantity": 1
            }
          ]
        }
      }
    }
  },
  "expected": {
    "allow": false,
    "reasonContains": "This purchase totals $1,390.00 but the agent's limit is $1,200.00"
  }
}
