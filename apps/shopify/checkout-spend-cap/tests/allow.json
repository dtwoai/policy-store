{
  "description": "Travel & expense: agent completes a flight booking totalling $980.00 (98000 minor units) under a $1,200.00 cap (max_total 120000, USD). Total is within the cap and the currency matches, so complete_checkout is allowed.",
  "input": {
    "action": "tool_pre_invoke",
    "kind": "tool_pre_invoke",
    "mode": "input",
    "subject": {
      "claims": {
        "sub": "agent|travel-bot",
        "email": "travel-agent@acme.example.com"
      }
    },
    "resource": {
      "type": "tool",
      "name": "shopify-complete_checkout",
      "uri": null
    },
    "context": {
      "mandate": {
        "max_total": 120000,
        "currency": "USD"
      }
    },
    "payload": {
      "name": "shopify-complete_checkout",
      "args": {
        "checkout": {
          "status": "ready_for_complete",
          "currency": "USD",
          "continue_url": "https://shop.example.com/checkouts/def456/continue",
          "totals": [
            { "type": "subtotal", "amount": 92000, "display_text": "Subtotal" },
            { "type": "tax", "amount": 6000, "display_text": "Tax" },
            { "type": "total", "amount": 98000, "display_text": "Total" }
          ],
          "line_items": [
            {
              "id": "li_1",
              "item": {
                "id": "flight_sfo_jfk",
                "title": "SFO to JFK, economy",
                "price": 92000
              },
              "quantity": 1
            }
          ]
        }
      }
    }
  },
  "expected": {
    "allow": true
  }
}
