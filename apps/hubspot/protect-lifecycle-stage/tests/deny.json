    "mode": "input",
    "resource": {
      "type": "tool",
      "name": "hubspot-manage-crm-objects",
      "uri": null
    },
    "payload": {
      "name": "hubspot-manage-crm-objects",
      "args": {
        "updateRequest": {
          "objects": [
            {
              "objectType": "contacts",
              "id": "12345",
              "properties": {
                "lifecyclestage": "customer"
              }
            }
          ]
        }
      }
