---
import Base from '../layouts/Base.astro';
import { getPolicies, getApps, getBundles } from '../lib/catalog';
import { stories } from '../data/stories';

const policies = getPolicies();
const apps = getApps();
const bundles = getBundles();
const site = Astro.site!;

const title = 'DTwo Policy Store';
const description =
  'A reviewed catalog of OPA/Rego policies for the DTwo MCP Gateway. Allow, deny, redact, or rewrite the calls AI agents make to Slack, Jira, Salesforce, and HubSpot.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    url: site.href,
    description,
    publisher: { '@type': 'Organization', name: 'DTwo', url: 'https://dtwo.ai' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: site.href,
    isPartOf: { '@type': 'WebSite', name: title, url: site.href },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Policy guides',
      itemListElement: stories.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/stories/${s.slug}`, site).href,
        name: s.title,
      })),
    },
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <span class="eyebrow">OPA / Rego for the DTwo MCP Gateway</span>
    <h1>
      <span class="line-1">Govern what</span>
      <span class="line-2">your agents do</span>
    </h1>
    <p class="dek">
      A reviewed catalog of OPA/Rego policies for the DTwo MCP Gateway. Allow, deny,
      redact, or rewrite the calls AI agents make to Slack, Jira, Salesforce, and HubSpot.
    </p>
  </section>
  <hr class="glow-divider" />

  <p>
    An AI agent connected to Slack, Jira, or your CRM can take actions with side
    effects you can't undo. The DTwo MCP Gateway runs an OPA/Rego policy on every
    tool call and decides what happens next: pass it through, deny it, redact the
    response, or rewrite the request before it lands.
  </p>
  <p>
    This is the catalog of those policies — {policies.length} of them across {apps.length}
    apps and {bundles.length} bundles. Each one is small and does a single thing, so you
    build a posture by attaching several. If you have a problem in mind, start from a
    <a href="/stories">story</a>. If you already know the policy you want,
    <a href="/policies">browse the full list</a>.
  </p>

  <section aria-labelledby="stories-h">
    <span class="eyebrow section-eyebrow">Start with a problem</span>
    <h2 id="stories-h">Stories</h2>
    <ul class="rows">
      {
        stories.map((s) => (
          <li>
            <a href={`/stories/${s.slug}`}>{s.title}</a>
            <br /><small>{s.dek}</small>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="apps-h">
    <span class="eyebrow section-eyebrow">Browse by app</span>
    <h2 id="apps-h">Apps</h2>
    <ul class="rows">
      {
        apps.map((a) => (
          <li>
            <a href={`/apps/${a.slug}`}>{a.title}</a> <small>· {a.policies.length} policies</small>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="bundles-h">
    <span class="eyebrow section-eyebrow">Browse by bundle</span>
    <h2 id="bundles-h">Bundles</h2>
    <ul class="rows">
      {
        bundles.map((b) => (
          <li>
            <a href={`/bundles/${b.slug}`}>{b.title}</a> <small>· {b.policies.length} policies</small>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="machine-h">
    <span class="eyebrow section-eyebrow">For machines</span>
    <h2 id="machine-h">Read it as data</h2>
    <p>
      Agents can read this catalog the same way people do:
      <a href="/llms.txt">/llms.txt</a> indexes it,
      <a href="/llms-full.txt">/llms-full.txt</a> inlines every policy, and
      <a href="/catalog.json">/catalog.json</a> serves it structured. The source of
      truth is the
      <a href="https://github.com/dtwoai/dtwo-policy-store">dtwo-policy-store</a> repository.
    </p>
  </section>
</Base>
