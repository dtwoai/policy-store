---
// Brand bar + primary navigation. The DTwo logomark and wordmark link home;
// the current section is marked with aria-current for a11y + styling.
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/stories', label: 'Stories' },
  { href: '/apps', label: 'Apps' },
  { href: '/bundles', label: 'Bundles' },
  { href: '/policies', label: 'Policies' },
  { href: '/tags', label: 'Tags' },
];
function active(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="site">
  <div class="site-bar">
    <a class="brand" href="/">
      <img src="/dtwo.svg" alt="DTwo" width="26" height="28" />
      <span>DTwo <span class="brand-accent">Policy Store</span></span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
