---
// Floating pill header: DTwo logomark + wordmark (links home), section nav, and
// a sun/moon theme toggle. Current section is marked with aria-current. The
// toggle's click handler + no-flash init live in Base.astro.
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/stories', label: 'Stories' },
  { href: '/apps', label: 'Apps' },
  { href: '/bundles', label: 'Bundles' },
  { href: '/policies', label: 'Policies' },
  { href: '/tags', label: 'Tags' },
];
function active(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="site">
  <div class="site-bar">
    <a class="brand" href="/">
      <img src="/dtwo.svg" alt="" width="24" height="26" />
      <span>DTwo <span class="brand-accent">Policy Store</span></span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
    </button>
  </div>
</header>
