---
import '@fontsource-variable/archivo';
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { repoLinks } from '../lib/catalog';

export interface Crumb {
  name: string;
  /** Site-absolute path. Omit on the current (last) item. */
  path?: string;
}

interface Props {
  title: string;
  description: string;
  /** Site-absolute canonical path. Defaults to the current pathname. */
  canonical?: string;
  ogType?: 'website' | 'article';
  /** ISO date for article:published_time. */
  publishedTime?: string;
  /** Visible breadcrumbs; also emitted as BreadcrumbList JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD object(s) for this page. */
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  publishedTime,
  breadcrumbs = [],
  jsonLd,
} = Astro.props;

const SITE_NAME = 'DTwo Policy Store';
const site = Astro.site ?? new URL('https://policies.dtwo.ai');
const canonicalPath = canonical ?? Astro.url.pathname;
// Root must match the sitemap's bare-origin <loc> (no trailing slash); other
// paths already have none under trailingSlash:'never'.
const canonicalUrl = canonicalPath === '/' ? site.origin : new URL(canonicalPath, site).href;
// Drop the brand suffix on long titles so the meaningful part survives SERP truncation.
const fullTitle = title === SITE_NAME || title.length > 48 ? title : `${title} — ${SITE_NAME}`;

const breadcrumbJsonLd =
  breadcrumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          ...(c.path ? { item: new URL(c.path, site).href } : {}),
        })),
      }
    : null;

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [breadcrumbJsonLd, ...extra].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Set the theme before first paint to avoid a flash. Dark is the brand
      // default; light is opt-in via [data-theme="light"] and remembered.
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const sysLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = saved ?? (sysLight ? 'light' : 'dark');
          if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
        } catch (_) {
          /* dark is the CSS default */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/dtwo.svg" />
    <meta name="theme-color" content="#15202b" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- OpenGraph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Agentic discovery: point machines at the structured + full-text indexes -->
    <link rel="alternate" type="text/markdown" href={new URL('/llms.txt', site).href} title="llms.txt" />
    <link rel="alternate" type="application/json" href={new URL('/catalog.json', site).href} title="Machine-readable catalog" />

    {allJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main class="page" id="main" tabindex="-1">
      {
        breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              {breadcrumbs.map((c) => (
                <li>{c.path ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <footer class="site">
      <span>© 2026 DTwo · Policy Store</span>
      <span>
        <a href="/llms.txt">llms.txt</a> ·
        <a href="/llms-full.txt">llms-full</a> ·
        <a href="/catalog.json">catalog.json</a> ·
        <a href="/sitemap-index.xml">sitemap</a> ·
        <a href={repoLinks.repo}>GitHub</a>
      </span>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        const sync = () => {
          const light = document.documentElement.getAttribute('data-theme') === 'light';
          btn.setAttribute('aria-pressed', String(light));
          btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
        };
        sync();
        btn.addEventListener('click', () => {
          const light = document.documentElement.getAttribute('data-theme') === 'light';
          if (light) document.documentElement.removeAttribute('data-theme');
          else document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('theme', light ? 'dark' : 'light'); } catch (_) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
